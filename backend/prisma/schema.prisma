generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  DEVELOPER
}

enum ProjectEnvironment {
  PRODUCTION
  DEVELOPMENT
}

enum ProjectStatus {
  ACTIVE
  PAUSED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum SecurityAction {
  BLOCK
  WARN
  MASK
  ALLOW
}

enum RequestDecision {
  ALLOWED
  BLOCKED
  ERROR
}

enum RequestStage {
  AUTH
  RATE_LIMIT
  INPUT_SECURITY
  LLM
  OUTPUT_SECURITY
  COMPLETED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DEVELOPER)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String             @id @default(uuid())
  name        String
  description String?
  environment ProjectEnvironment @default(DEVELOPMENT)
  status      ProjectStatus      @default(ACTIVE)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  apiKeys        ApiKey[]
  securityPolicy SecurityPolicy?
  rateLimit      RateLimit?
  requestLogs    RequestLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model ApiKey {
  id String @id @default(uuid())

  name      String
  keyPrefix String
  keyHash   String @unique

  status ApiKeyStatus @default(ACTIVE)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  requestLogs RequestLog[]

  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model SecurityPolicy {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  promptInjectionEnabled Boolean        @default(true)
  promptInjectionAction  SecurityAction @default(BLOCK)

  piiDetectionEnabled Boolean        @default(true)
  piiDetectionAction  SecurityAction @default(WARN)

  secretDetectionEnabled Boolean        @default(true)
  secretDetectionAction  SecurityAction @default(BLOCK)

  outputScanningEnabled Boolean        @default(true)
  outputScanningAction  SecurityAction @default(WARN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateLimit {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  requestsPerMinute Int @default(60)
  requestsPerHour   Int @default(1000)
  requestsPerDay    Int @default(10000)

  burstLimit Int @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequestLog {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  decision RequestDecision
  stage    RequestStage

  model String?

  processedPrompt String? @db.Text
  responsePreview String? @db.Text

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)

  latencyMs Int?

  estimatedCostUsd Float @default(0)

  inputFindings  Json?
  outputFindings Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([apiKeyId])
  @@index([decision])
  @@index([stage])
  @@index([createdAt])
}
